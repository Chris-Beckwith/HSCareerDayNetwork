@using CareerDayApi.Models
@model LicenseInvitationEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Career Day Invitation</title>
</head>

<body style="margin:0; padding:0; background-color:#f5f5f5; font-family:Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f5f5; padding:40px 0;">
        <tr>
            <td align="center">

                <table width="600" cellpadding="0" cellspacing="0"
                       style="background-color:#ffffff; border-radius:8px; overflow:hidden;">

                    <tr>
                        <td style="padding:30px; text-align:center;">
                            <img src="https://hscareerdaysurvey.com/images/NHSCDN-logo.png"
                                 alt="Career Day"
                                 style="max-width:220px; height:auto;" 
                            />
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:10px 40px 40px 40px; color:#333333;">

                            <h1 style="text-align:center; margin-bottom:25px;">
                                Thank You for Your Purchase!
                            </h1>

                            <p style="font-size:16px; line-height:1.6;">
                                Thank you for choosing National High School Career Day Network!
                                We're excited to help you bring your career day event to life.
                            </p>

                            <p style="font-size:16px; line-height:1.6;">
                                Your <b>@Model.LicenseType</b> license is ready to be registered.
                                Click the button below to set up your account and get started.
                            </p>

                            <div style="text-align:center; margin:35px 0;">
                                <a href="@Model.RegistrationUrl"
                                   style="display:inline-block;
                                          padding:14px 28px;
                                          background-color:#1976d2;
                                          color:#ffffff;
                                          text-decoration:none;
                                          border-radius:5px;
                                          font-size:16px;">
                                    Register Your License
                                </a>
                            </div>

                            <p style="font-size:16px; line-height:1.6;">
                                If you have any questions or need assistance getting started, please reach out to us. We're happy to help!
                            </p>

                            <p style="font-size:16px; line-height:1.6;">
                                Thank you, <br />The National High School Career Day Team<br />
                            </p>

                            <p style="font-size:14px; color:#666666; line-height:1.5;">
                                <br /><br />
                                This invitation expires on
                                @Model.ExpirationDate.ToString("MMMM d, yyyy").
                            </p>

                            <p style="font-size:14px; color:#666666; line-height:1.5;">
                                If you weren't expecting this invitation,
                                you can safely ignore this email.
                            </p>

                        </td>
                    </tr>

                    <tr>
                        <td style="padding:20px 40px; background-color:#f5f5f5; text-align:center;">
                            <p style="margin:0; font-size:12px; color:#777777;">
                                National High School Career Day Network
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>